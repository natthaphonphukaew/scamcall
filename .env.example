# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่า — ห้าม commit .env.local
# บน Vercel ใส่ชุดเดียวกันที่ Project → Settings → Environment Variables (ดู docs/DEPLOY.md)
# ชื่อรุ่นเช็กจาก https://ai.google.dev/gemini-api/docs/models (ล่าสุด 2026-10-09)

# --- Gemini (จำเป็น) ---
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_ANALYSIS_MODEL=gemini-3.5-flash-lite
# (ไม่บังคับ) text model ของแชทจำลอง — เว้นว่าง = ใช้รุ่นเดียวกับ GEMINI_ANALYSIS_MODEL
GEMINI_CHAT_MODEL=
GEMINI_LIVE_VOICE=Orus

# ตัดสายอัตโนมัติ (วินาที)
MAX_CALL_SECONDS=180

# --- Leaderboard + ผลทดสอบ (ไม่ใส่ = ปิดฟีเจอร์นี้ ส่วนอื่นใช้ได้ปกติ) ---
# สุ่มยาว >= 32 ตัวอักษร ใช้เซ็นคะแนนกันโกง (ดูคำสั่งสุ่มใน docs/DEPLOY.md)
RESULT_SIGNING_SECRET=
# Supabase → Project Settings → Data API (URL) และ API Keys → Secret key (sb_secret_...)
# URL แค่ https://<project-ref>.supabase.co — ไม่ต้องมี /rest/v1/ ต่อท้าย
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- ระบบผู้เล่น (guest + login Google) — docs/DEPLOY.md ข้อ 7 ---
# ค่าเหล่านี้ส่งไป browser ได้ (publishable key สิทธิ์ต่ำ) · ไม่ใส่ = ปิดระบบผู้เล่น
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
